{
  "name": "askar-erp-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "pos-mvp",
    "askar-admin-dashboard",
    "askar-khata-pwa",
    "askar-edge-api"
  ],
  "scripts": {
    "dev:pos": "npm --prefix pos-mvp run dev",
    "dev:dashboard": "npm --prefix askar-admin-dashboard run dev",
    "dev:khata": "npm --prefix askar-khata-pwa run dev",
    "dev:edge": "npm --prefix askar-edge-api run dev",
    "build:pos": "npm --prefix pos-mvp run build",
    "build:dashboard": "npm --prefix askar-admin-dashboard run build",
    "build:khata": "npm --prefix askar-khata-pwa run build",
    "build:apk": "powershell.exe -ExecutionPolicy Bypass -File pos-mvp/build_and_package_apk.ps1",
    "deploy:edge": "npm --prefix askar-edge-api run deploy",
    "deploy:dashboard": "npm --prefix askar-admin-dashboard run deploy",
    "test:audit": "npm --prefix pos-mvp run test:audit"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "playwright": "^1.65.1"
  }
}
