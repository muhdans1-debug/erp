datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TransactionType {
  YOU_GAVE
  YOU_GOT
}

enum PaymentType {
  CASH
  CARD
  BENEFIT_PAY
  BANK_TRANSFER
  CHEQUE
  CREDIT
  CREDIT_LEDGER
  UPI
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  phone        String
  address      String?
  currentDue   Decimal       @default(0.000) @db.Decimal(12, 3)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  invoices     Invoice[]
  orders       Order[]

  @@index([phone])
  @@index([name])
}

model Transaction {
  id         String          @id @default(uuid())
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       TransactionType
  amount     Decimal         @db.Decimal(12, 3)
  note       String?
  createdAt  DateTime        @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model Invoice {
  id          String      @id @default(uuid())
  invoiceNo   String      @unique
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  partyName   String
  partyPhone  String?
  itemsJson   String
  subtotal    Decimal     @db.Decimal(12, 3)
  tax         Decimal     @default(0.000) @db.Decimal(12, 3)
  grandTotal  Decimal     @db.Decimal(12, 3)
  paymentType PaymentType @default(CASH)
  createdAt   DateTime    @default(now())

  @@index([invoiceNo])
  @@index([createdAt])
}

model Purchase {
  id          String      @id @default(uuid())
  billNo      String
  vendorName  String
  amount      Decimal     @db.Decimal(12, 3)
  note        String?
  paymentMode PaymentType @default(CASH)
  createdAt   DateTime    @default(now())

  @@index([vendorName])
  @@index([createdAt])
}

model User {
  id        String   @id @default(uuid())
  tenantId  String?
  email     String   @unique
  name      String
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String?
  name        String
  sku         String?  @unique
  price       Decimal  @db.Decimal(12, 3)
  costPrice   Decimal? @db.Decimal(12, 3)
  stock       Int      @default(0)
  stockQty    Int      @default(0)
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([sku])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  name      String?  @default("")
  quantity  Int      @default(1)
  qty       Int?     @default(1)
  unitPrice Decimal  @default(0.000) @db.Decimal(12, 3)
  price     Decimal  @default(0.000) @db.Decimal(12, 3)
  total     Decimal  @default(0.000) @db.Decimal(12, 3)
}

model Order {
  id            String      @id @default(uuid())
  orderNo       String      @unique
  tenantId      String?
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  totalAmount   Decimal     @db.Decimal(12, 3)
  status        String      @default("PENDING")
  paymentMethod PaymentType @default(CASH)
  itemsJson     String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([orderNo])
  @@index([createdAt])
}

model StoreProfile {
  id        String   @id @default("default-store")
  name      String   @default("LAYALI COLD STORE")
  phone     String   @default("+973 3912 3456")
  address   String   @default("Seef Mall, Ground Floor, Manama, Kingdom of Bahrain")
  gstin     String?  @default("CR-104928-1")
  upiId     String?  @default("+973 3912 3456")
  updatedAt DateTime @updatedAt
}
