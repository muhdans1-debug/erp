# Ignore local SQLite databases and logs
*.db
*.db-wal
*.db-shm
*.db-info
*.sqlite
*.sqlite3
*.log

# Ignore heavy native Android, Tauri and build artifacts
android/
src-tauri/
platform-tools/
archives/
scratch/
dist/
build/
.vercel/

# Ignore node modules and environment variables
node_modules/
.env
.env.local

# Ignore screenshots, PNG previews, and temporary test dumps
*.png
*.jpg
*.jpeg
*.tsbuildinfo
*.apk

