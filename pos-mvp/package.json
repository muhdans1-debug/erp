{
  "name": "pos-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:web": "vite --port 5173 --host 0.0.0.0",
    "server": "node server.js",
    "build": "tsc && vite build",
    "dist": "npm run build && electron-builder",
    "electron:dev": "electron .",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:manager": "vite --port 5175 --host 0.0.0.0",
    "db:hydrate": "node scripts/hydrate_from_turso.mjs",
    "start:master": "concurrently -n \"API,BRIDGE,DASH\" -c \"bgBlue.bold,bgMagenta.bold,bgCyan.bold\" \"node server.js\" \"node bridgeServer.js\" \"cd ../askar-admin-dashboard && npm run dev\""
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/network": "^8.0.1",
    "@capgo/capacitor-nfc": "^8.3.2",
    "@capgo/capacitor-updater": "^8.54.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.7",
    "@fastify/static": "^10.1.8",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@types/qrcode": "^1.5.6",
    "capacitor-sunmi-printer": "^0.0.3",
    "fastify": "^5.12.7",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.56.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "com.askarpos.app",
    "productName": "Askar POS",
    "electronVersion": "45.2.1",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "local.db",
      "schema.sql",
      "quick_products_config.json",
      "khata_config.json"
    ],
    "files": [
      "dist/**/*",
      "server.js",
      "db.js",
      "schema.sql",
      "bridgeServer.js",
      "electron-main.js",
      "package.json",
      "repositories/**/*",
      "services/**/*",
      "syncEngine.js",
      "src/automation/**/*",
      "quick_products_config.json",
      "khata_config.json",
      "local.db",
      "!android",
      "!platform-tools",
      "!archives",
      "!scratch"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}