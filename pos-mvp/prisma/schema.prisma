// ====================================================================
// ASKAR SUPERMARKET ERP - CANONICAL PRISMA SCHEMA (SINGLE SOURCE OF TRUTH)
// Standardized across LibSQL Local Embedded Replicas, Turso Cloud, & POS
// ====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("TURSO_DATABASE_URL")
}

// --------------------------------------------------------------------
// 1. Unified Shift & Cash Reconciliation Model (Replaces ShiftSession)
// --------------------------------------------------------------------
model Shift {
  id               String    @id @default(uuid())
  tenantId         String    @default("tenant_1")
  cashierName      String?   @default("Cashier 1")
  employeeId       String?   @default("emp_cashier_1")
  openedAt         DateTime  @default(now())
  closedAt         DateTime?
  
  // Starting till float
  openingFloat     Float     @default(50.0) // BHD float (also aliased as openingCash)
  openingCash      Float     @default(50.0)
  
  // Shift sales financial breakdown (standardized naming)
  totalCashSales   Float     @default(0.0)
  totalCardSales   Float     @default(0.0)
  totalKhataSales  Float     @default(0.0)
  
  // Cash reconciliation
  expectedDrawer   Float?    @default(0.0)  // System expected cash
  expectedCash     Float?    @default(0.0)
  actualDrawer     Float?    // Blind count entered by cashier
  actualCash       Float?
  variance         Float?    // actual - expected (negative = SHORT, positive = OVER)
  denominations    String?   // JSON breakdown of cash/coin counts
  notes            String?   // Handover notes
  status           String    @default("OPEN") // OPEN, CLOSED, RECONCILED

  // Relations
  employee         Employee? @relation(fields: [employeeId], references: [id])
  sales            Sale[]
}

// --------------------------------------------------------------------
// 2. Transaction & Sales Ledger Models (Standardized to 'total')
// --------------------------------------------------------------------
model Sale {
  id              String        @id @default(uuid())
  tenantId        String        @default("tenant_1")
  invoiceNo       String        @unique
  invoiceSeq      Int?          @default(0) // Strict sequential integer for NBR VAT compliance
  customerId      String?
  subtotal        Float         // Price before tax
  vatTotal        Float         @default(0.0) // Total VAT collected
  totalVat        Float         @default(0.0)
  
  // Standardized financial total paid by customer
  total           Float
  totalAmount     Float         @default(0.0) // Compatibility alias
  
  paymentType     String        // CASH, BENEFIT_PAY, KHATA
  status          String        @default("COMPLETED") // COMPLETED or REFUNDED
  syncStatus      String        @default("PENDING")
  createdAt       DateTime      @default(now())
  timestamp       DateTime      @default(now())
  
  employeeId      String?
  employee        Employee?     @relation(fields: [employeeId], references: [id])
  shiftId         String?
  shift           Shift?        @relation(fields: [shiftId], references: [id])

  customer        Customer?     @relation(fields: [customerId], references: [id])
  items           SaleItem[]
  refunds         Refund[]
}

model SaleItem {
  id            String       @id @default(uuid())
  tenantId      String       @default("tenant_1")
  saleId        String
  productId     String
  quantity      Float        // Supports fractional weights e.g. 1.250 kg
  qty           Float?       // Alias for quantity
  priceAtSale   Float
  price         Float?       // Alias for priceAtSale
  costAtSale    Float        @default(0.0)
  vatRateAtSale Float        @default(10.0) // NBR tax rate frozen at sale time
  vatAmount     Float        @default(0.0)
  total_price   Float?       // quantity * priceAtSale
  
  sale          Sale         @relation(fields: [saleId], references: [id])
  product       Product      @relation(fields: [productId], references: [id])
  refundItems   RefundItem[]
}

// --------------------------------------------------------------------
// 3. Product Catalog & Inventory
// --------------------------------------------------------------------
model Product {
  id              String       @id
  tenantId        String       @default("tenant_1")
  name            String
  purchasePrice   Float
  unitCost        Float        @default(0.0)
  sellingPrice    Float
  stockQuantity   Int          @default(0)
  minThreshold    Int          @default(20)  // Reorder danger zone
  maxThreshold    Int          @default(100) // Par level
  supplierName    String?      @default("Local Distributor")
  supplierEmail   String?      @default("supplier@askar.bh")
  distributorId   String?
  distributor     Distributor? @relation(fields: [distributorId], references: [id])
  vatRate         Float        @default(10.0) // 10.0 for standard, 0.0 for basic food
  taxRate         Float        @default(0.10)
  barcode         String?
  is_weighed_item Boolean      @default(false)
  category        String?      @default("ESSENTIALS")
  updatedAt       DateTime     @default(now())
  
  SaleItem        SaleItem[]
  wastageLogs     WastageLog[]
}

// --------------------------------------------------------------------
// 4. Distributors & Auto-Replenishment
// --------------------------------------------------------------------
model Distributor {
  id                String          @id
  tenantId          String          @default("tenant_1")
  name              String          @unique
  whatsappNumber    String          @default("97339000000") // Bahrain format
  contactEmail      String?         @default("orders@supplier.bh")
  minimumOrderValue Float           @default(0.0) // MOV requirement
  deliveryDays      String?         // e.g. "MON,WED,THU"
  createdAt         DateTime        @default(now())
  
  products          Product[]
  purchaseOrders    PurchaseOrder[]
}

model PurchaseOrder {
  id             String       @id
  distributorId  String?
  distributor    Distributor? @relation(fields: [distributorId], references: [id])
  supplierName   String
  whatsappNumber String?      @default("97339000000")
  supplierEmail  String?      @default("supplier@askar.bh")
  status         String       @default("DRAFT") // DRAFT, APPROVED, IN_TRANSIT, RECEIVED
  estimatedCost  Float
  vatPaid        Float        @default(0.0)
  itemsJson      String       // JSON payload of ordered line items
  createdAt      DateTime     @default(now())
}

// --------------------------------------------------------------------
// 5. Customer Ledger (Khata Hub) & NFC Wallets
// --------------------------------------------------------------------
model Customer {
  id           String        @id @default(uuid())
  tenantId     String        @default("tenant_1")
  name         String
  phone        String?
  cpr          String?       // Bahrain CPR
  batchNo      String?
  description  String?
  nfcCardId    String?       @unique // Replaces both cardUid and nfc_card_id
  cardUid      String?       // Deprecated alias for legacy readers
  nfc_card_id  String?       // Deprecated alias for legacy readers
  khataPin     String?       // Replaces pin and khata_pin
  khata_pin    String?       @default("1234")
  pin          String?       @default("1234")
  access_token String?
  balance      Float         @default(0.0) // Single source of truth for Khata balance
  credit_limit Float         @default(30.0)
  createdAt    DateTime?     @default(now())
  updatedAt    DateTime?     @updatedAt
  is_active    Int           @default(1)
  isActive     Int           @default(1)
  mess_id      String?
  messGroup    MessGroup?    @relation(fields: [mess_id], references: [id])

  Sale         Sale[]
  ledger       KhataLedger[]
  nfcCards     NfcCard[]
}

model KhataLedger {
  id              String    @id
  tenantId        String    @default("tenant_1")
  customerId      String
  amount          Float     // Positive for CHARGE, negative for PAYMENT
  type            String    // CHARGE, PAYMENT, WRITE_OFF
  running_balance Float?    @default(0.0)
  reference       String?   // e.g. INV-0045, Cash Payment, BenefitPay
  syncStatus      String    @default("PENDING")
  timestamp       DateTime  @default(now())
  created_at      DateTime? @default(now())
  
  customer        Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model InvoiceSequence {
  name        String @id
  current_seq Int    @default(4999)
}

// --------------------------------------------------------------------
// 6. Employees & Security
// --------------------------------------------------------------------
model Employee {
  id        String   @id @default(uuid())
  tenantId  String   @default("tenant_1")
  name      String
  pin_code  String   @unique
  role      String   // CASHIER or MANAGER
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
  
  shifts    Shift[]
  sales     Sale[]
}

// --------------------------------------------------------------------
// 7. Operations, Wastage & Refunds
// --------------------------------------------------------------------
model WastageLog {
  id          String   @id
  tenantId    String   @default("tenant_1")
  productId   String
  productName String
  quantity    Int
  unitCost    Float
  totalLoss   Float
  reason      String   // EXPIRED, DAMAGED, STOLEN
  loggedBy    String   @default("Admin")
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id])
}

model Refund {
  id             String       @id
  tenantId       String       @default("tenant_1")
  saleId         String
  invoiceNo      String
  refundedAmount Float
  reason         String
  destination    String       // CASH, KHATA_CREDIT
  itemsJson      String?
  processedBy    String       @default("Cashier")
  createdAt      DateTime     @default(now())

  sale           Sale         @relation(fields: [saleId], references: [id])
  items          RefundItem[]
}

model RefundItem {
  id          String    @id
  tenantId    String    @default("tenant_1")
  refundId    String
  saleItemId  String?
  productId   String
  productName String
  quantity    Int
  unitPrice   Float
  totalAmount Float
  isDamaged   Int       @default(0)

  refund      Refund    @relation(fields: [refundId], references: [id])
  saleItem    SaleItem? @relation(fields: [saleItemId], references: [id])
}

model Expense {
  id          String   @id
  type        String   // BUSINESS or PERSONAL
  category    String   // RENT, ELECTRICITY, SALARY, OWNER_DRAW
  amount      Float
  vatPaid     Float    @default(0.0)
  description String?
  recordedBy  String   @default("Admin")
  createdAt   DateTime @default(now())
}

model ProductPriceHistory {
  id           String   @id
  tenantId     String   @default("tenant_1")
  productId    String
  productName  String?
  oldPrice     Float
  newPrice     Float
  oldCost      Float?
  newCost      Float?
  changeReason String?
  changedBy    String   @default("Manager")
  createdAt    DateTime @default(now())
}

model NfcCard {
  tag_id      String     @id
  card_type   String     // PERSONAL or MESS
  customer_id String?
  customer    Customer?  @relation(fields: [customer_id], references: [id])
  mess_id     String?
  mess        MessGroup? @relation(fields: [mess_id], references: [id])
  createdAt   DateTime   @default(now())
}

model MessGroup {
  id         String     @id @default(uuid())
  tenantId   String     @default("tenant_1")
  group_name String
  nfcCards   NfcCard[]
  members    Customer[]
  createdAt  DateTime   @default(now())
}

