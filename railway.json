{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && pnpm install && pnpm --filter @starline/api build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @starline/api start",
    "restartPolicyType": "ON_FAILURE"
  }
}